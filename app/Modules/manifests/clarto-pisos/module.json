{
    "$schema": "https://schemas.liberu.dev/module/v1.json",
    "name": "clarto-pisos",
    "display_name": "pisos.com portal",
    "description": "Publishes, updates and withdraws properties on pisos.com from the property's Portals tab.",
    "version": "1.0.0",
    "category": "product",
    "module_type": "feature",
    "provider": "App\\Providers\\ClartoModulesServiceProvider",
    "requires": {
        "php": "^8.5",
        "laravel": "^13.0",
        "packages": {}
    },
    "suggests": [],
    "capabilities": ["clarto.pisos"],
    "default_enabled": true,
    "features": ["Publish on pisos.com", "Update listing", "Withdraw listing", "Listing status"],
    "clarto": {
        "key": "pisos",
        "implementation": "host",
        "gates": ["PisosConnector publish/update"]
    }
}
